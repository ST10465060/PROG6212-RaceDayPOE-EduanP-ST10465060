@model List<RaceDay.Contracts.Venues.VenueDto>

@{
    ViewData["Title"] = "Connection test";
}

<h1>RaceDay</h1>

@if (Model.Any())
{
    <p class="text-success">Connected to the API. @Model.Count venue(s) returned.</p>
    <ul>
        @foreach (var venue in Model)
        {
            <li>@venue.VenueName — @venue.City (@venue.EventCount events)</li>
        }
    </ul>
}
else
{
    <p class="text-danger">No data came back. Is the API running?</p>
}
