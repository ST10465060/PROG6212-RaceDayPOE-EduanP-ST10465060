@using RaceDay.Web.Services
@model RaceDay.Contracts.Events.EventDetailDto
@{
    ViewData["Title"] = Model.EventName;
}

<h2>@Model.EventName</h2>
<p class="text-muted">Organised by @Model.OrganiserName</p>

@if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
{
    <img src="@Model.BannerImageUrl" alt="@Model.EventName banner"
         class="img-fluid rounded mb-3" style="max-height: 300px; object-fit: cover; width: 100%;" />
}

<dl class="row">
    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.EventDate.ToString("dddd, dd MMMM yyyy")</dd>

    <dt class="col-sm-3">Type and distance</dt>
    <dd class="col-sm-9">@Model.EventType over @Model.DistanceKm.ToString("0.##") km</dd>

    <dt class="col-sm-3">Venue</dt>
    <dd class="col-sm-9">@Model.VenueName, @Model.City, @Model.Province</dd>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <dt class="col-sm-3">About this race</dt>
        <dd class="col-sm-9">@Model.Description</dd>
    }
</dl>

<h4 class="mt-4">Choose a category</h4>

@if (!Model.Categories.Any())
{
    <div class="alert alert-warning">
        The organiser has not added any categories to this race yet.
    </div>
}
else if (!Context.Session.IsLoggedIn())
{
    @* Show the categories, but make signing in the obvious next step. *@
    <div class="alert alert-info">
        <a asp-controller="Account" asp-action="Login"
           asp-route-returnUrl="@Context.Request.Path">Sign in</a>
        or
        <a asp-controller="Account" asp-action="Register">create an account</a>
        to enter this race.
    </div>
}

@if (Model.Categories.Any())
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Category</th>
                <th>Distance</th>
                <th>Entry fee</th>
                <th>Spaces left</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model.Categories)
            {
                <tr>
                    <td>@category.CategoryName</td>
                    <td>@category.DistanceKm.ToString("0.##") km</td>
                    <td>R @category.EntryFee.ToString("0.00")</td>
                    <td>
                        @* SpacesRemaining is worked out by the API *@
                        @if (category.SpacesRemaining <= 0)
                        {
                            <span class="badge bg-danger">Full</span>
                        }
                        else
                        {
                            <text>@category.SpacesRemaining of @category.MaxParticipants</text>
                        }
                    </td>
                    <td class="text-end">
                        @if (Context.Session.IsParticipant())
                        {
                            @if (category.SpacesRemaining <= 0)
                            {
                             
                                <button class="btn btn-sm btn-secondary" disabled>Full</button>
                            }
                            else
                            {
                                <form asp-controller="Enrolments" asp-action="Enrol" method="post">
                                    <input type="hidden" name="categoryId" value="@category.CategoryId" />
                                    <input type="hidden" name="eventId" value="@Model.EventId" />
                                    <button type="submit" class="btn btn-sm btn-success">Enter</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index" class="btn btn-link px-0">Back to all races</a>